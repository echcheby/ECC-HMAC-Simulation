(*
 * ProVerif model for New_Authentication_Protocol_Ecc_HMAC
 * Symbolic abstractions for ECC and MAC
 *)

free c_reg: channel [private].
free c_auth: channel.

free P: bitstring.
free KS: bitstring.
free KT: bitstring.

free SKST: bitstring [private].
free sS: bitstring [private].
free sT: bitstring [private].
free iST: bitstring [private].

fun mac(bitstring, bitstring): bitstring.
fun verS(bitstring, bitstring, bitstring): bitstring.
fun verT(bitstring, bitstring, bitstring): bitstring.
fun dh(bitstring, bitstring): bitstring.
fun h(bitstring): bitstring.
fun mul(bitstring, bitstring): bitstring.
fun c2(bitstring, bitstring): bitstring.
fun c3(bitstring, bitstring, bitstring): bitstring.
fun c4(bitstring, bitstring, bitstring, bitstring): bitstring.

(* Events for authentication and secrecy *)
event begin_S(bitstring, bitstring, bitstring).
event end_T(bitstring, bitstring, bitstring).

event skst_T(bitstring).
event skst_S(bitstring).
event secret_rt(bitstring).
event secret_rs(bitstring).

(* Secrecy queries *)
query attacker(SKST).
query x: bitstring; event(skst_T(x)) ==> attacker(x).
query x: bitstring; event(skst_S(x)) ==> attacker(x).
query x: bitstring; event(secret_rt(x)) ==> attacker(x).
query x: bitstring; event(secret_rs(x)) ==> attacker(x).

(* Authentication queries *)
query x: bitstring, y: bitstring, z: bitstring; event(end_T(x,y,z)) ==> event(begin_S(x,y,z)).

let T() =
  new rT: bitstring;
  let RT = mul(rT, P) in
  let CT = mac(SKST, c2(RT, iST)) in
  let YT = verT(RT, CT, KT) in
  out(c_reg, (RT, YT, CT));
  in(c_reg, (RS: bitstring, YS: bitstring));
  if YS = verS(RS, CT, KS) then
    event skst_T(SKST);
    event secret_rt(RT);
    (* Authentication phase *)
    in(c_auth, (RS2: bitstring, CT2: bitstring, YS2: bitstring, Sig: bitstring));
    if CT2 = mac(SKST, c2(RS2, iST)) then
    if YS2 = verS(RS2, CT2, KS) then
    if Sig = mac(SKST, c4(RS2, iST, CT2, YS2)) then
      event skst_T(SKST);
      event end_T(RS2, CT2, YS2)
  else 0.

let S() =
  new rS: bitstring;
  let RS = mul(rS, P) in
  in(c_reg, (RT: bitstring, YT: bitstring, CT: bitstring));
  if YT = verT(RT, CT, KT) then
    let YS = verS(RS, CT, KS) in
    out(c_reg, (RS, YS));
    event skst_S(SKST);
    event secret_rs(RS);
    (* Authentication phase *)
    new rS2: bitstring;
    let RS2 = mul(rS2, P) in
    let CT2 = mac(SKST, c2(RS2, iST)) in
    let YS2 = verS(RS2, CT2, KS) in
    let Sig = mac(SKST, c4(RS2, iST, CT2, YS2)) in
    event begin_S(RS2, CT2, YS2);
    out(c_auth, (RS2, CT2, YS2, Sig));
    event skst_S(SKST)
  else 0.

process
  (!T() | !S())
