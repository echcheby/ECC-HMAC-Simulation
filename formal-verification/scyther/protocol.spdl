/*
 * New_Authentication_Protocol_Ecc_HMAC - Scyther model
 *
 * ECC and MAC are abstracted symbolically for Scyther.
 */

hashfunction H;
function mac;
function verT;
function verS;
function dh;

const KT, KS: Nonce;   // Public keys (symbolic)
secret SKAB: Function; // Pre-shared secret
secret sS, sT: Nonce;  // Long-term private keys (not algebraically linked here)
secret iST: Nonce;     // Session counter (modeled as shared secret)

protocol NewAuth(S,T)
{
    role T
    {
        fresh RT: Nonce;
        var CT, YT: Nonce;
        var RS, YS: Nonce;

        var RS2, CT2, YS2, Sig: Nonce;

          // Registration (secure channel)
          send_!1(T,S, RT,
              verT(RT, mac(SKAB, RT, iST), KT),
              mac(SKAB, RT, iST));

          recv_!2(S,T, RS, YS);
        match(YS, verS(RS, mac(SKAB, RT, iST), KS));

        // Authentication
        recv_3(S,T, RS2, CT2, YS2, Sig);
        match(CT2, mac(SKAB, RS2, iST));
        match(YS2, verS(RS2, CT2, KS));
        match(Sig, mac(SKAB, RS2, iST, CT2, YS2));

        // State update (symbolic)
        match(H(H(dh(RT, RS), iST), iST, YS2), H(H(dh(RT, RS), iST), iST, YS2));

        claim_T1(T, Secret, SKAB);
        claim_T2(T, Secret, H(dh(RT, RS), iST));
        claim_T3(T, Secret, RT);
        claim_T4(T, Alive);
        claim_T5(T, Weakagree);
        claim_T6(T, Niagree);
        claim_T7(T, Nisynch);
    }

    role S
    {
        fresh RS: Nonce;
        var RT, YT, CT: Nonce;
        var YS: Nonce;

        fresh RS2: Nonce;
        var CT2, YS2, Sig: Nonce;

        // Registration (secure channel)
        recv_!1(T,S, RT, YT, CT);
        match(YT, verT(RT, CT, KT));

        send_!2(S,T, RS, verS(RS, CT, KS));

        // Authentication
        match(CT2, mac(SKAB, RS2, iST));
        match(YS2, verS(RS2, CT2, KS));
        match(Sig, mac(SKAB, RS2, iST, CT2, YS2));
          send_3(S,T, RS2, CT2, YS2, Sig);

        // State update (symbolic)
        match(H(H(dh(RT, RS), iST), iST, YS2), H(H(dh(RT, RS), iST), iST, YS2));

        claim_S1(S, Secret, SKAB);
        claim_S2(S, Secret, H(dh(RT, RS), iST));
        claim_S3(S, Secret, RS);
        claim_S4(S, Alive);
        claim_S5(S, Weakagree);
        claim_S6(S, Niagree);
        claim_S7(S, Nisynch);
    }
}
